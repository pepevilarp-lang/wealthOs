{
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/send-push",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/radar",
      "schedule": "30 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/instinct/:path*",
      "destination": "/api/instinct?route=:path*"
    }
  ]
}
