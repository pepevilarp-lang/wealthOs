# Copia este archivo como .env.local y rellena los valores. Nunca lo subas al repo.
# Los mismos nombres van en Vercel → Settings → Environment Variables.

# Supabase (servidor). La URL y la clave anónima del cliente están en index.html.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE=

# IA (Groq) — Mentor y extracción de documentos
GROQ_API_KEY=
# Opcionales: sustituyen a los modelos por defecto
# GROQ_MODEL_TEXT=openai/gpt-oss-120b
# GROQ_MODEL_VISION=qwen/qwen3.8-27b

# Noticias
NEWS_API_KEY=
FINNHUB_KEY=
TWELVEDATA_KEY=
FMP_KEY=

# Notificaciones push (genera el par con: npx web-push generate-vapid-keys)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:tu@email.com

# Cron de Vercel (/api/send-push)
CRON_SECRET=
